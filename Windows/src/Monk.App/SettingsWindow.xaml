<Window x:Class="Monk.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monk Settings" Width="560" Height="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#181528" Foreground="#F7F5FF">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Default access" FontSize="25" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <CheckBox Content="Block applications by default" IsChecked="{Binding DefaultBlockingEnabled}" />
            <TextBlock TextWrapping="Wrap" Foreground="#AAA5B8" FontSize="12" Margin="0,8,0,0"
                       Text="When enabled, every app outside the list remains blocked between timed focuses. Monk, the Windows shell, Settings, and security surfaces stay available." />
        </StackPanel>
        <TextBox Grid.Row="2" Text="{Binding ApplicationQuery, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,18,0,8" ToolTip="Search always-allowed applications" />
        <ListBox Grid.Row="3" ItemsSource="{Binding Applications}" Background="#0EFFFFFF" BorderBrush="#20FFFFFF">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected}" Margin="8,5">
                        <StackPanel>
                            <TextBlock Text="{Binding DisplayName}" />
                            <TextBlock Text="{Binding Detail}" Foreground="#777286" FontSize="10"
                                       TextTrimming="CharacterEllipsis" Width="450" />
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button Grid.Row="4" Content="Apply" Command="{Binding ApplyCommand}"
                Style="{StaticResource PrimaryButton}" Margin="0,18,0,0" HorizontalAlignment="Right" Width="120" />
    </Grid>
</Window>
