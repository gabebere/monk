<Window x:Class="Monk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monk" Width="680" Height="650"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">
    <Border CornerRadius="26" BorderBrush="#35FFFFFF" BorderThickness="1"
            MouseLeftButtonDown="OnDragWindow">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#15121E" Offset="0" />
                <GradientStop Color="#1D1930" Offset="0.52" />
                <GradientStop Color="#12363D" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="34,28,34,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="10" BorderBrush="#42FFFFFF" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#7569EC" Offset="0" />
                                <GradientStop Color="#2EA99E" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="M" Foreground="White" FontSize="15" FontWeight="SemiBold"
                                   FontFamily="Georgia" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Monk" Foreground="{StaticResource TextPrimary}" FontSize="17"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="11,0,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Settings" Style="{StaticResource QuietButton}" Click="OnSettings" />
                    <TextBlock Text="·" Foreground="#5F5A68" VerticalAlignment="Center" Margin="2,0" />
                    <Button Content="Hide" Style="{StaticResource QuietButton}" Click="OnHide" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,27,0,0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="What are you doing now?" Foreground="{StaticResource TextSecondary}"
                               FontSize="14" FontWeight="SemiBold" Margin="2,0,0,8" />
                    <Grid>
                        <TextBox Text="{Binding Intention, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="27" FontWeight="SemiBold" Padding="15,11" />
                        <TextBlock Text="Write the one thing that matters" Foreground="#5F5A69"
                                   FontSize="17" Margin="16,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Intention}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="For" Foreground="{StaticResource TextSecondary}" FontSize="14"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,16,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBox Text="{Binding Hours, UpdateSourceTrigger=PropertyChanged}" Width="58"
                                 HorizontalContentAlignment="Center" />
                        <TextBlock Text="hours" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="8,0,18,0" />
                        <TextBox Text="{Binding Minutes, UpdateSourceTrigger=PropertyChanged}" Width="58"
                                 HorizontalContentAlignment="Center" />
                        <TextBlock Text="minutes" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,20,0,0">
                    <Grid Margin="2,0,2,8">
                        <TextBlock Text="Allowed applications" Foreground="{StaticResource TextSecondary}"
                                   FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="Tick only what you need" Foreground="#918C9B"
                                   FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid>
                        <TextBox Text="{Binding ApplicationQuery, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Search installed applications" Foreground="#5F5A69" FontSize="14"
                                   Margin="15,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ApplicationQuery}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Border Background="#0B000000" BorderBrush="#18FFFFFF" BorderThickness="1"
                            CornerRadius="12" Margin="0,7,0,0" MaxHeight="174"
                            Visibility="{Binding HasVisibleApplications, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ListBox ItemsSource="{Binding Applications}" MaxHeight="172">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="14" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </CheckBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,19,0,0">
                    <Grid Margin="2,0,2,8">
                        <TextBlock Text="Allowed websites" Foreground="{StaticResource TextSecondary}"
                                   FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="One domain per line" Foreground="#918C9B" FontSize="12"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid>
                        <TextBox Text="{Binding Domains, UpdateSourceTrigger=PropertyChanged}" Height="72"
                                 AcceptsReturn="True" TextWrapping="Wrap" />
                        <TextBlock Text="docs.microsoft.com" Foreground="#5F5A69" FontSize="14"
                                   Margin="15,12" VerticalAlignment="Top" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Domains}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="5" Margin="0,18,0,0">
                    <TextBlock Foreground="#878291" FontSize="11" TextWrapping="Wrap" Margin="2,0,0,12"
                               Text="Outside apps close immediately. Your commitment cannot be ended before the timer reaches zero." />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding BeginCommand}" HorizontalAlignment="Stretch">
                        <Grid>
                            <TextBlock Text="Begin focus" HorizontalAlignment="Center" />
                            <TextBlock Text="Enter  ↵" HorizontalAlignment="Right" Foreground="#D9FFFFFF" FontSize="11" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,28,0,0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="570">
                    <TextBlock Text="{Binding ActiveIntention}" Foreground="{StaticResource TextPrimary}" FontSize="32"
                               FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding RemainingTime}" Foreground="White" FontSize="72"
                               FontWeight="Light" TextAlignment="Center" Margin="0,12,0,20" />
                    <ItemsControl ItemsSource="{Binding ActiveApplications}" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#14FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1"
                                        CornerRadius="14" Padding="11,7" Margin="4">
                                    <TextBlock Text="{Binding}" Foreground="#DFDBEB" FontSize="12" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding LastBlockedActivity}" Foreground="#9993A4" FontSize="12"
                               TextAlignment="Center" Margin="0,18,0,0" />

                    <StackPanel Margin="0,38,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAwaitingDecision}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Session complete" Foreground="White" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" />
                        <TextBlock Text="Keep going, or return to your default access?" Foreground="{StaticResource TextSecondary}"
                                   Margin="0,6,0,15" TextAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="15 min" Command="{Binding ExtendFifteenCommand}" Margin="4" />
                            <Button Content="30 min" Command="{Binding ExtendThirtyCommand}" Margin="4" />
                            <Button Content="1 hour" Command="{Binding ExtendHourCommand}" Margin="4" />
                            <Button Content="End session" Command="{Binding EndCommand}" Style="{StaticResource PrimaryButton}" Margin="4" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="At zero, choose whether to extend or end." Foreground="#85808E"
                               FontSize="12" TextAlignment="Center" Margin="0,30,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAwaitingDecision}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
