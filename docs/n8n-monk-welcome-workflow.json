{
  "name": "Monk Welcome Email",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "monk-welcome",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "3f5c0bb0-4c14-46d7-b5f5-5aa22b1a9d8a",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const payload = $json.body ?? $json;\n\nconst userId = String(payload.userId ?? '').trim();\nconst email = String(payload.email ?? '').trim().toLowerCase();\nconst firstNameRaw = String(payload.firstName ?? '').trim();\nconst provider = String(payload.provider ?? 'unknown').trim();\n\nconst valid = userId.length > 0 && email.includes('@');\nconst firstName = firstNameRaw.length > 0 ? firstNameRaw : null;\n\nconst plainText = `Hey ${firstName ?? 'there'},\\n\\nNice to meet you — I'm Gabriel, founder of Monk.\\n\\nThanks for signing up. If you reply to this email, it comes directly to me. I'd love to hear what you're trying to focus on and what would make Monk better for you.\\n\\nWelcome aboard,\\nGabriel\\nFounder, Monk`;\n\nreturn [{\n  json: {\n    userId,\n    email,\n    firstName,\n    provider,\n    valid,\n    reason: valid ? null : 'missing_user_or_email',\n    plainText,\n    raw: payload\n  }\n}];"
      },
      "id": "e3e8af1b-0e97-4fcb-965a-26a0e6073879",
      "name": "Normalize Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.valid}}",
              "value2": true
            }
          ]
        }
      },
      "id": "f3ca9bdd-fad0-4e5b-b12d-c4224a138f8b",
      "name": "Valid Payload?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        740,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const store = $getWorkflowStaticData('global');\nif (!store.sentUsers) {\n  store.sentUsers = {};\n}\n\nconst key = String($json.userId || $json.email || '').trim().toLowerCase();\nif (!key) {\n  return [{ json: { ...$json, shouldSend: false, reason: 'missing_user_key' } }];\n}\n\nif (store.sentUsers[key]) {\n  return [{ json: { ...$json, shouldSend: false, reason: 'already_sent' } }];\n}\n\nstore.sentUsers[key] = new Date().toISOString();\nreturn [{ json: { ...$json, shouldSend: true } }];"
      },
      "id": "d4dc0db4-2f41-4fe6-b213-235bc9dd6ec0",
      "name": "Dedupe User",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        220
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.shouldSend}}",
              "value2": true
            }
          ]
        }
      },
      "id": "303f42b7-7d4c-4972-9fdd-86db6b55f15d",
      "name": "Should Send?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1220,
        220
      ]
    },
    {
      "parameters": {
        "sendTo": "={{$json.email}}",
        "subject": "={{`Welcome to Monk, ${$json.firstName || 'there'}`}}",
        "message": "={{$json.plainText}}",
        "options": {}
      },
      "id": "6f0eb8a7-bff4-4ac7-bf88-810d5e2845f3",
      "name": "Send Welcome Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1460,
        120
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, sent: true, userId: $json.userId, email: $json.email } }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "53cab031-eb39-4a03-80d6-ff58c7e6472f",
      "name": "Respond Sent",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1700,
        120
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, sent: false, reason: $json.reason || 'already_sent' } }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "8a6c971e-39db-407a-a58b-df76f7f2e7ce",
      "name": "Respond Skipped",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1460,
        320
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: false, sent: false, reason: $json.reason || 'invalid_payload' } }}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "fd73a34a-b8f3-4e67-a958-6454fd5ecaf8",
      "name": "Respond Invalid",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        980,
        480
      ]
    }
  ],
